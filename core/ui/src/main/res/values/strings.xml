<?xml version="1.0" encoding="utf-8"?>
<!--
  EVERY user-visible string in Sprout lives in this one file, on purpose: the copy rules in
  docs/02-app-design.md are only reviewable if the copy is in one place.

  Never: "You broke your streak" · "You failed" · "Don't let Sprout down" · any loss framing.
  Misses are stated flatly and pointed at today. Praise is specific and comes from real numbers.
-->
<resources>

    <string name="today_title">Today</string>
    <string name="today_progress">%1$d of %2$d done</string>

    <!-- Endowed progress: the first screen already credits them for showing up. -->
    <string name="today_empty_title">Day 1 of 66</string>
    <string name="today_empty_body">You already showed up by being here. Add the first habit when you\'re ready.</string>
    <string name="today_add_habit">Add a habit</string>

    <!-- Habits exist, none due today. Says plainly that this is the plan, not a lapse. -->
    <string name="today_nothing_title">Nothing due today</string>
    <string name="today_nothing_body">That\'s the schedule you chose, not a day you missed.</string>

    <!-- The three things Today may say about a miss. There is no fourth. -->
    <string name="note_missed_yesterday">Missed yesterday. One miss changes almost nothing — today does.</string>
    <string name="note_repairable">Your run is paused. Doing this today picks it back up.</string>
    <string name="note_bounced_back">You came back. That\'s the day that counts most.</string>

    <string name="habit_strength_description">%1$s, strength %2$d of 100</string>
    <string name="habit_run">%1$d in a row</string>
    <string name="habit_best_run">best %1$d</string>
    <!-- A fraction, not a percentage: the denominator is the chances that really existed. -->
    <string name="habit_recent">done %1$d of %2$d</string>

    <string name="action_complete">Mark done</string>
    <string name="action_undo">Undo</string>
    <string name="action_more">More options</string>
    <string name="action_skip">Skip today</string>
    <string name="action_minimum">Did the smallest version</string>
    <string name="action_clear">Clear today</string>

    <!-- Shown after a skip so the gesture visibly did something. Stated, never scolded. -->
    <string name="status_skipped">Skipped today</string>
    <string name="action_close">Close</string>

    <!--
      Shine: the one line the app says when a habit is ticked off.

      Every line here is generated from numbers the user produced, and each has a test asserting
      the claim is arithmetically true. There is deliberately no generic fallback: when nothing
      true is left to say, the app says nothing, because "Nice job!" is exactly the filler this
      file exists to keep out. At most one line ever appears, and coming back after a miss always
      wins over all of these.
    -->
    <string name="shine_first">That\'s the first one. Every run this habit ever has starts here.</string>

    <!-- The plant moved on a stage. Once each, and the app\'s signature moment. -->
    <string name="shine_stage_sprout">That one turned the seed into a sprout.</string>
    <string name="shine_stage_sapling">That one grew it into a sapling.</string>
    <string name="shine_stage_tree">That one made it a tree.</string>
    <!-- No number quoted: the threshold is the scorer\'s to hold, not this sentence\'s to promise. -->
    <string name="shine_stage_ingrained">Strong, and for long enough now to count as ingrained.</string>

    <plurals name="shine_run">
        <item quantity="one">%1$d in a row, and no run of yours has been longer.</item>
        <item quantity="other">%1$d in a row, and no run of yours has been longer.</item>
    </plurals>
    <plurals name="shine_week_best">
        <item quantity="one">%1$d time this week. No week of yours has been better.</item>
        <item quantity="other">%1$d times this week. No week of yours has been better.</item>
    </plurals>
    <plurals name="shine_week_count">
        <item quantity="one">That\'s %1$d time this week.</item>
        <item quantity="other">That\'s %1$d times this week.</item>
    </plurals>

    <!--
      Notes. The user's own words about a day, kept as they typed them and never interpreted.
      Nothing here asks why, and nothing calls a note an excuse or a reason: "Ran the short loop
      instead" is a fact about a Tuesday, and the app has no opinion about it.

      A note hangs off a day that was logged. There is deliberately no way to write one on a day
      with no entry — the absence of that row is what a miss means, and inventing one to hold a
      sentence would make Today treat the day as answered.
    -->
    <string name="action_note_add">Add a note</string>
    <string name="action_note_edit">Edit note</string>
    <string name="note_dialog_title">Note for today</string>
    <string name="note_label">Note</string>
    <!-- An observation, not a justification. The example sets the tone for what people write. -->
    <string name="note_hint">Ran the short loop instead</string>
    <string name="note_save">Save</string>
    <string name="note_cancel">Cancel</string>
    <!-- Says what clearing the field does, so removing a note is never a guess. -->
    <string name="note_clear_help">Leave it empty to remove the note.</string>

    <!--
      Habit creation. One question per screen: the cue and the coping plan are the intervention,
      and on a single scrolling form they are the two fields everybody skips.
    -->
    <string name="create_title">New habit</string>
    <string name="create_step">Step %1$d of %2$d</string>
    <string name="create_back">Back</string>
    <string name="create_next">Next</string>
    <string name="create_save">Create habit</string>
    <string name="create_optional">Optional — you can add this later.</string>

    <string name="create_what_title">What are you building?</string>
    <string name="create_name_label">Habit</string>
    <string name="create_name_hint">Morning run</string>
    <string name="create_type_do">Do it</string>
    <string name="create_type_count">Count it</string>
    <string name="create_type_avoid">Avoid it</string>
    <string name="create_unit_label">Unit</string>
    <string name="create_unit_hint">pages</string>
    <string name="create_target_label">Daily target</string>
    <string name="create_identity_label">I\'m someone who…</string>
    <string name="create_identity_hint">runs in the morning</string>
    <string name="create_identity_help">How strongly people tie a habit to who they are predicts whether they keep it.</string>

    <string name="create_smallest_title">What\'s the smallest version that still counts?</string>
    <string name="create_smallest_body">This is what you do on the worst day, instead of nothing. Make it almost too small to fail.</string>
    <string name="create_smallest_label">Smallest version</string>
    <string name="create_smallest_hint">Put my running shoes on</string>

    <string name="create_cue_title">When and where?</string>
    <string name="create_cue_body">Deciding this in advance is the most reliable single thing in the research. Finish the sentence.</string>
    <string name="create_cue_prefix">If</string>
    <string name="create_cue_hint">it\'s 7am and I\'ve had my coffee</string>
    <!-- Habit names are noun phrases ("Morning run"), so the sentence cannot say "I'll <name>". -->
    <string name="create_cue_then">…then: %1$s.</string>

    <string name="create_coping_title">And when it goes wrong?</string>
    <string name="create_coping_body">Everyone misses. Deciding the fallback now is what keeps a missed morning from becoming a missed week.</string>
    <string name="create_coping_prefix">If I miss it, then</string>
    <string name="create_coping_hint">I\'ll do it right after dinner</string>

    <string name="create_schedule_title">How often?</string>
    <string name="create_schedule_daily">Every day</string>
    <string name="create_schedule_days">Certain days</string>
    <string name="create_schedule_weekly">A few times a week</string>
    <string name="create_schedule_interval">Every few days</string>
    <string name="create_schedule_days_empty">Pick at least one day.</string>
    <string name="create_schedule_times">%1$d times a week</string>
    <string name="create_schedule_times_help">Scored by the week, so one bad Tuesday can still be a good week.</string>
    <string name="create_schedule_every">Every %1$d days</string>

    <string name="create_reminder_title">Want a nudge?</string>
    <string name="create_reminder_body">You can change or remove it any time.</string>
    <string name="create_reminder_switch">Remind me</string>
    <string name="create_reminder_change">Change time</string>
    <string name="create_reminder_dialog_title">Remind me at</string>
    <string name="create_reminder_confirm">Set</string>
    <string name="create_reminder_cancel">Cancel</string>

    <string name="stage_seed">Seed</string>
    <string name="stage_sprout">Sprout</string>
    <string name="stage_sapling">Sapling</string>
    <string name="stage_tree">Tree</string>
    <string name="stage_ingrained">Ingrained</string>


    <!-- Reminders. Neutral by design: a notification that implies you have failed is the one
         people turn off, and a reminder the user has silenced cannot help them at all. -->
    <string name="notify_channel_reminders">Habit reminders</string>
    <string name="notify_channel_reminders_desc">A nudge at the time you chose, on the days the habit is scheduled.</string>
    <string name="notify_prompt">Time for this one.</string>
    <string name="notify_done">Done</string>
    <string name="notify_skip">Skip</string>
    <string name="notify_snooze">Later</string>

    <!--
      Permission prompts. Written to say what the user loses, not what the app wants: "Sprout
      needs permission" is about the app, "reminders won't appear" is about them.
    -->
    <string name="perm_notify_needed">Reminders need permission to appear.</string>
    <string name="perm_notify_blocked">Notifications are turned off for Sprout, so reminders won\'t appear.</string>
    <string name="perm_allow">Allow</string>
    <string name="perm_open_settings">Open settings</string>
    <!-- No minute count: the window is Android's to choose, and quoting one would be a promise. -->
    <string name="perm_exact_body">Android may deliver this a few minutes late to save battery.</string>
    <string name="perm_exact_action">Allow exact timing</string>
    <!-- On Today, where the reminder was set some time ago and has been quietly failing since. -->
    <string name="perm_reminders_silenced">Your reminders aren\'t arriving — notifications are turned off for Sprout.</string>
    <!--
      Editing. The wizard's questions without the wizard's voice: somebody who came to move a
      reminder by ten minutes should not be talked through a decision they made months ago. The
      headings are labels, not questions — their job is to be findable.
    -->
    <string name="edit_title">Edit habit</string>
    <string name="edit_save">Save changes</string>
    <!-- Headings that say something the field label underneath does not already say:
         "Smallest version" over a box labelled "Smallest version" is furniture. -->
    <string name="edit_section_habit">What you\'re building</string>
    <string name="edit_section_smallest">On a bad day</string>
    <string name="edit_section_cue">When and where</string>
    <string name="edit_section_coping">When it goes wrong</string>
    <string name="edit_section_schedule">How often</string>
    <string name="edit_section_reminder">Reminder</string>

    <!-- States the two consequences plainly. Archiving is reversible, so nothing here warns. -->
    <string name="edit_archived_body">Archived. It\'s off Today, and its reminder won\'t fire.</string>
    <string name="edit_archive">Archive</string>
    <string name="edit_restore">Restore</string>
    <string name="edit_delete">Delete</string>

    <!-- Names what is lost and names the gentler option. "Are you sure?" is not information. -->
    <string name="edit_delete_title">Delete %1$s?</string>
    <string name="edit_delete_body">Every day you logged for it goes with it. Archiving takes it off Today and keeps the history.</string>
    <string name="edit_delete_keep">Keep it</string>

    <string name="edit_discard_title">Leave without saving?</string>
    <string name="edit_discard">Discard</string>
    <string name="edit_keep_editing">Keep editing</string>

    <!-- Today shows what is due today; this is where the rest of them are. -->
    <string name="habits_title">All habits</string>
    <string name="habits_archived">Archived</string>
    <string name="habits_empty">Nothing here yet. Habits you add will be listed here, archived ones included.</string>
    <string name="action_edit">Edit habit</string>

    <!--
      Habit detail: the habit's own history. Every number here is one the user produced, and the
      denominators are real — "done 18 of 22" counts the chances that existed, never a flat 30.
      Nothing on this screen is drawn in the error colour: a missed day is grey.
    -->
    <string name="detail_identity">I\'m someone who %1$s</string>
    <plurals name="detail_window">
        <item quantity="one">Last week</item>
        <item quantity="other">Last %1$d weeks</item>
    </plurals>
    <string name="detail_empty">Nothing logged yet. The first day you tick it off, this fills in.</string>
    <!-- Days one to six. States what is coming, and does not imply the habit is behind. -->
    <string name="detail_early">Off to a start. The curve and calendar fill in over the first week.</string>

    <string name="detail_runs_current">In a row now</string>
    <string name="detail_runs_best">Best run</string>
    <string name="detail_runs_recent">Last 30 days</string>
    <!-- A fraction, so the denominator can say how many chances there actually were. -->
    <string name="detail_runs_fraction">%1$d / %2$d</string>
    <plurals name="detail_rest_days">
        <item quantity="one">%1$d rest day banked</item>
        <item quantity="other">%1$d rest days banked</item>
    </plurals>

    <string name="detail_curve_title">Strength</string>
    <plurals name="detail_curve_description">
        <item quantity="one">Strength over the last week, ending at %2$d out of 100.</item>
        <item quantity="other">Strength over the last %1$d weeks, ending at %2$d out of 100.</item>
    </plurals>

    <string name="detail_calendar_title">Calendar</string>
    <plurals name="detail_calendar_description">
        <item quantity="one">Last week: %2$d done, %3$d missed, %4$d skipped.</item>
        <item quantity="other">Last %1$d weeks: %2$d done, %3$d missed, %4$d skipped.</item>
    </plurals>
    <string name="detail_legend_done">Done</string>
    <string name="detail_legend_missed">Missed</string>
    <string name="detail_legend_skipped">Skipped</string>

    <string name="detail_plan_title">The plan</string>
    <!-- The stored halves are situations; the "if… then" sentence around them is copy, so it
         stays translatable and survives a rename of the habit. -->
    <string name="detail_plan_cue">If %1$s, then %2$s.</string>
    <string name="detail_plan_coping">If I miss it, then %1$s.</string>
    <string name="detail_plan_smallest">On a bad day: %1$s</string>
    <string name="detail_plan_empty">No cue or fallback yet. They\'re the part of a habit the research is most sure about — Edit adds them.</string>

    <string name="detail_weekdays_title">Which days</string>
    <!-- A count of days done, never a percentage: the denominator differs per schedule. -->
    <plurals name="detail_weekdays_description">
        <item quantity="one">%1$s: %2$d done in the last week.</item>
        <item quantity="other">%1$s: %2$d done in the last %3$d weeks.</item>
    </plurals>

    <string name="detail_notes_title">Notes</string>

    <!-- Opens the habit's own screen. Editing lives one tap further in, on that screen. -->
    <string name="action_open">Open habit</string>
</resources>
